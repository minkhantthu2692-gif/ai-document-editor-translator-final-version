          "listMarker": null,
          "lines": [
            {
              "text": "Annual Report 2026 - Chapter 1",
              "bbox": {
                "x": 72,
                "y": 12.37,
                "w": 134.03,
                "h": 12.39
              },
              "fontFamily": "Helvetica-Bold",
