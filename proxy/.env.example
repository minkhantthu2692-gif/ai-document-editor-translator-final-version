# Server-side only. Never prefix with VITE_. Never commit .env.
OPENROUTER_ASSISTANT_KEY=

# Optional: port the proxy listens on (defaults to 8787).
PORT=8787

# Optional: extra CORS origins allowed to call the proxy, comma-separated.
# http://localhost:5173 and http://127.0.0.1:5173 are always allowed.
ALLOWED_ORIGIN=http://localhost:5173

# Optional: OpenRouter model id (defaults to nvidia/nemotron-3-super-120b-a12b:free).
# ASSISTANT_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Optional: number of trusted proxy hops in front of this server (Render/Railway/Fly: 1).
# Needed there so per-IP rate limiting sees the real client IP instead of the load balancer.
# TRUST_PROXY=1
