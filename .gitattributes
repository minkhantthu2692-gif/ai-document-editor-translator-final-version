# Normalize line endings: LF in the repository for scripts that must run on
# any OS, CRLF for Windows batch files (cmd is picky about bare LF).
* text=auto

*.sh text eol=lf
*.gs text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Source and config stay LF in the *working tree*, not just in the repository.
# `* text=auto` alone normalizes on commit but checks CRLF out on Windows, and
# Prettier is configured with endOfLine: "lf" — so a fresh clone failed
# `prettier --check .` on every file it had never opened, and `--write` then
# reported files as changed whose contents Git considered identical.
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.js text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf

# Keep generated/collected binary assets out of line-ending conversion.
# fixtures/text-300p.pdf is ASCII-only, so Git would otherwise treat it as
# text and rewrite every LF as CRLF on checkout, breaking its xref table.
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pfb binary
*.bcmap binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
