# ---------------------------------------------------------------------------
# AI Documents Translator & Editor — environment (copy to `.env` and edit).
#
#   cp .env.example .env      (Linux/macOS)
#   copy .env.example .env    (Windows cmd)
#
# `.env` is git-ignored; never commit real keys or tokens.
# All values are optional — the app runs fully locally without them.
# ---------------------------------------------------------------------------

# Google Apps Script web-app endpoint used by cloud sync (Settings → Data).
# Must end with /exec. Leave empty to keep everything in this browser.
VITE_APPS_SCRIPT_URL=

# Shared secret token you set in Apps Script Script Properties (`SYNC_TOKEN`).
# Sent with every sync request; the server rejects mismatches (UNAUTHORIZED).
VITE_APPS_SCRIPT_TOKEN=

# Base URL of the Troubleshooting Assistant proxy (proxy/ Node server or the
# Cloudflare Worker). The OpenRouter key lives on the server — never here.
# Example: http://localhost:8787
# Leave empty to use the built-in offline rule-based assistant.
VITE_ASSISTANT_PROXY_URL=

# Local PDF sidecar (`sidecar/server.py`) used for OCR and PDF parsing.
# Left commented out, the app still finds it at http://localhost:8790 whenever
# it is running — so copying this file changes nothing. Uncomment to point at
# a different host/port, or set it to a blank value to turn the sidecar off
# entirely (the browser-only path then always runs).
# VITE_PDF_SIDECAR_URL=http://localhost:8790

# Base path the app is served from when not at the domain root.
# GitHub Pages project sites need `/REPO_NAME/` (the deploy workflow sets
# this automatically). Leave empty for a root deployment.
VITE_BASE=
